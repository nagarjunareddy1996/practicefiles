    answer: data "aws_ami" "amazon_linux" {
      most_recent = true
    
      filter {
        name   = "name"
        values = ["amzn2-ami-hvm-*-x86_64-gp2"]
      }
    
      filter {
        name   = "virtualization-type"
        values = ["hvm"]
      }
    
      owners = ["amazon"] # Amazon-owned AMIs
    }

